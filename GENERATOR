const FRAME_BYTES = 216;
const FRAME_SAMPLES = 50;
const SAMPLE_RATE = 200;
const FRAME_MS = 250;

let ejecutando = false;
let sismo = false;
let workerCount = 3;

const seq = new Map();
const tiempo = new Map();

let timer = null;

self.onmessage = event => {
    const msg = event.data;

    if (msg.tipo === "init") {
        workerCount = msg.workerCount || 3;
        ejecutando = true;
        iniciarReloj();
    }

    if (msg.tipo === "sismo") {
        sismo = true;

        setTimeout(() => {
            sismo = false;
        }, 12000);
    }

    if (msg.tipo === "detener") {
        ejecutando = false;

        if (timer) {
            clearTimeout(timer);
            timer = null;
        }
    }
};

function iniciarReloj() {
    if (timer) return;

    tick();
}

function tick() {
    if (!ejecutando) return;

    for (let estacion = 1; estacion <= 9; estacion++) {
        for (let canal = 0; canal < 3; canal++) {
            generarFrame(estacion, canal);
        }
    }

    timer = setTimeout(tick, FRAME_MS);
}

function generarFrame(estacion, canal) {
    const key = estacion + ":" + canal;

    const actualSeq = seq.get(key) || 0;
    const actualTiempo =
        tiempo.get(key) ||
        performance.timeOrigin * 1000;

    seq.set(key, actualSeq + 1);
    tiempo.set(
        key,
        actualTiempo + FRAME_MS
    );

    const buffer =
        new ArrayBuffer(FRAME_BYTES);

    const view =
        new DataView(buffer);

    view.setUint16(
        0,
        estacion,
        true
    );

    view.setUint8(
        2,
        canal
    );

    let flags = 0;

    if (Math.random() < 0.01) {
        flags |= 1;
    }

    if (Math.random() < 0.01) {
        flags |= 2;
    }

    view.setUint8(3, flags);

    view.setUint32(
        4,
        actualSeq,
        true
    );

    view.setFloat64(
        8,
        actualTiempo,
        true
    );

    for (let i = 0; i < FRAME_SAMPLES; i++) {
        let valor =
            (Math.random() - 0.5) * 100;

        if (sismo) {
            const onda =
                Math.sin(
                    (actualSeq * FRAME_SAMPLES + i) * 0.15
                );

            valor +=
                onda * (700 + Math.random() * 700);
        }

        view.setInt32(
            16 + i * 4,
            Math.round(valor),
            true
        );
    }

    // 1-12 tramas perdidas durante una ráfaga.
    if (Math.random() < 0.025) {
        return;
    }

    const workerId =
        Math.floor((estacion - 1) / 3) + 1;

    // 4% con retraso para provocar desorden.
    if (Math.random() < 0.04) {
        const copia = buffer.slice(0);

        setTimeout(() => {
            if (ejecutando) {
                self.postMessage(
                    {
                        tipo: "frame",
                        workerId,
                        buffer: copia
                    },
                    [copia]
                );
            }
        }, 250 + Math.random() * 500);

        return;
    }

    // Se crea la copia ANTES de transferir el buffer original,
    // porque después de postMessage(..., [buffer]) el ArrayBuffer queda detached.
    let duplicado = null;

    if (Math.random() < 0.008) {
        duplicado = buffer.slice(0);
    }

    self.postMessage(
        {
            tipo: "frame",
            workerId,
            buffer
        },
        [buffer]
    );

    // 0.8% de duplicados. La copia también se transfiere.
    if (duplicado) {
        setTimeout(() => {
            if (ejecutando) {
                self.postMessage(
                    {
                        tipo: "frame",
                        workerId,
                        buffer: duplicado
                    },
                    [duplicado]
                );
            }
        }, 20);
    }
}
