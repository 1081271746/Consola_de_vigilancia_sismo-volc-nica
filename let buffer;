let buffer;

let staBuffer = new Float64Array(200);
let ltaBuffer = new Float64Array(6000);

let staIndex = 0;
let ltaIndex = 0;

let staSuma = 0;
let ltaSuma = 0;

let staCantidad = 0;
let ltaCantidad = 0;

let indice = 0;
let disparo = false;
let ejecutando = false;
let generarSismo = false;

self.onmessage = function(e) {

    if (e.data.tipo === "init") {

        buffer = new Float32Array(e.data.buffer);

        ejecutando = true;

        procesar();
    }

    if (e.data.tipo === "sismo") {
        generarSismo = true;

        setTimeout(() => {
            generarSismo = false;
        }, 5000);
    }

    if (e.data.tipo === "detener") {
        ejecutando = false;
    }
};

function procesar() {

    if (!ejecutando) return;

    let valor;

    if (generarSismo) {
        valor = (Math.random() - 0.5) * 20;
    } else {
        valor = (Math.random() - 0.5) * 2;
    }

    let energia = valor * valor;

    // STA
    if (staCantidad < 200) {
        staBuffer[staIndex] = energia;
        staSuma += energia;
        staCantidad++;
    } else {
        staSuma -= staBuffer[staIndex];
        staBuffer[staIndex] = energia;
        staSuma += energia;
    }

    staIndex = (staIndex + 1) % 200;

    // LTA
    if (!disparo) {

        if (ltaCantidad < 6000) {
            ltaBuffer[ltaIndex] = energia;
            ltaSuma += energia;
            ltaCantidad++;
        } else {
            ltaSuma -= ltaBuffer[ltaIndex];
            ltaBuffer[ltaIndex] = energia;
            ltaSuma += energia;
        }

        ltaIndex = (ltaIndex + 1) % 6000;
    }

    let sta = staSuma / Math.max(staCantidad, 1);
    let lta = ltaSuma / Math.max(ltaCantidad, 1);

    let ratio = lta > 0 ? sta / lta : 0;

    // Detector
    if (!disparo && ratio >= 4) {

        disparo = true;

        self.postMessage({
            tipo: "evento",
            ratio: ratio
        });
    }

    if (disparo && ratio <= 1.5) {

        disparo = false;

        self.postMessage({
            tipo: "normal",
            ratio: ratio
        });
    }

    // Buffer circular
    buffer[indice] = valor;

    indice = (indice + 1) % buffer.length;

    self.postMessage({
        tipo: "dato",
        valor: valor,
        ratio: ratio,
        amplitud: Math.abs(valor)
    });

    setTimeout(procesar, 5);
}