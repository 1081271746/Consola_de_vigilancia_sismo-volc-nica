const canvas = document.getElementById("grafico");
const ctx = canvas.getContext("2d");

const estado = document.getElementById("estado");
const ratioTexto = document.getElementById("ratio");
const amplitudTexto = document.getElementById("amplitud");
const muestrasTexto = document.getElementById("muestras");
const evento = document.getElementById("evento");

let worker;
let muestras = [];
let contador = 0;

const TAMANO_BUFFER = 6000;


const memoria = new SharedArrayBuffer(
    TAMANO_BUFFER * Float32Array.BYTES_PER_ELEMENT
);

const buffer = new Float32Array(memoria);

function iniciar() {

    worker = new Worker("worker.js");

    worker.postMessage({
        tipo: "init",
        buffer: memoria
    });

    worker.onmessage = function(e) {

        if (e.data.tipo === "dato") {

            muestras.push(e.data.valor);

            if (muestras.length > 900) {
                muestras.shift();
            }

            contador++;

            ratioTexto.textContent =
                e.data.ratio.toFixed(2);

            amplitudTexto.textContent =
                e.data.amplitud.toFixed(2);

            muestrasTexto.textContent =
                contador;
        }

        if (e.data.tipo === "evento") {

            estado.textContent = "EVENTO DETECTADO";
            estado.style.color = "red";

            evento.textContent =
                "ALERTA: disparo STA/LTA detectado. Relación: "
                + e.data.ratio.toFixed(2);
        }

        if (e.data.tipo === "normal") {

            estado.textContent = "MONITOREANDO";
            estado.style.color = "white";

            evento.textContent =
                "La señal volvió a valores normales.";
        }
    };

    dibujar();
}

function simularSismo() {

    if (worker) {

        worker.postMessage({
            tipo: "sismo"
        });
    }
}

function detener() {

    if (worker) {

        worker.postMessage({
            tipo: "detener"
        });

        worker.terminate();

        estado.textContent = "DETENIDO";
    }
}

function dibujar() {

    requestAnimationFrame(dibujar);

    ctx.clearRect(
        0,
        0,
        canvas.width,
        canvas.height
    );

    ctx.beginPath();

    for (let i = 0; i < muestras.length; i++) {

        let x =
            (i / 900) * canvas.width;

        let y =
            canvas.height / 2 -
            muestras[i] * 8;

        if (i === 0) {
            ctx.moveTo(x, y);
        } else {
            ctx.lineTo(x, y);
        }
    }

    ctx.strokeStyle = "lime";
    ctx.stroke();
}

